<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="TMA autonome" Manufacturer="TMA Standalone Contributors"
      Version="2.0.0" UpgradeCode="4E2C715F-1D33-4769-A56B-4954AD128700"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de TMA autonome est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TMA-Standalone" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="TMA autonome" Level="1">
      <ComponentGroupRef Id="TmaFiles" />
      <ComponentRef Id="CleanRoomComRegistration" />
      <ComponentRef Id="CleanRoomOutlookRegistration" />
      <ComponentRef Id="CleanRoomResiliency" />
    </Feature>
  </Package>

  <Fragment>
    <Component Id="CleanRoomComRegistration" Directory="INSTALLFOLDER" Guid="A2455011-95CC-42D0-A8AB-8E23C52AF70D">
      <RegistryValue Root="HKCU" Key="Software\Classes\TmaCleanRoom.Connect"
          Type="string" Value="TMA autonome Outlook Add-in" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\TmaCleanRoom.Connect\CLSID"
          Type="string" Value="{8F5373B8-4973-4E58-A69E-CB57AA22691C}" />
      <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{8F5373B8-4973-4E58-A69E-CB57AA22691C}\InprocServer32"
          Type="string" Value="mscoree.dll" />
      <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{8F5373B8-4973-4E58-A69E-CB57AA22691C}\InprocServer32"
          Name="ThreadingModel" Type="string" Value="Both" />
      <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{8F5373B8-4973-4E58-A69E-CB57AA22691C}\InprocServer32"
          Name="Class" Type="string" Value="TmaCleanRoom.Addin" />
      <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{8F5373B8-4973-4E58-A69E-CB57AA22691C}\InprocServer32"
          Name="Assembly" Type="string" Value="TmaCleanRoom.Addin, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null" />
      <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{8F5373B8-4973-4E58-A69E-CB57AA22691C}\InprocServer32"
          Name="RuntimeVersion" Type="string" Value="v4.0.30319" />
      <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{8F5373B8-4973-4E58-A69E-CB57AA22691C}\InprocServer32"
          Name="CodeBase" Type="string" Value="file:///[INSTALLFOLDER]TmaCleanRoom.Addin.dll" />
    </Component>

    <Component Id="CleanRoomOutlookRegistration" Directory="INSTALLFOLDER" Guid="B4B0DD43-B355-4B1C-B931-52A7768B5F08">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Office\Outlook\Addins\TmaCleanRoom.Connect"
          Name="FriendlyName" Type="string" Value="TMA autonome" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Office\Outlook\Addins\TmaCleanRoom.Connect"
          Name="Description" Type="string" Value="Complément Outlook autonome pour les réunions Microsoft Teams" />
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Office\Outlook\Addins\TmaCleanRoom.Connect"
          Name="LoadBehavior" Type="integer" Value="3" />
    </Component>

    <Component Id="CleanRoomResiliency" Directory="INSTALLFOLDER" Guid="D90EF3B7-708A-43CD-AC59-F86B38DF50E6">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Office\16.0\Outlook\Resiliency\DoNotDisableAddinList"
          Name="TmaCleanRoom.Connect" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
